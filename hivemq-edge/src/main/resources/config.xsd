<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <!--- root -->
    <xs:element name="hivemq" type="hiveMQConfigEntity"/>

    <xs:complexType name="hiveMQConfigEntity">
        <xs:all>
            <xs:element name="config-version" type="xs:integer" minOccurs="0"/>
            <xs:element name="mqtt-listeners" type="mqttListenersEntity" minOccurs="0"/>
            <xs:element name="mqtt-sn-listeners" type="mqttsnListenersEntity" minOccurs="0"/>
            <xs:element name="mqtt" type="mqttConfigEntity" minOccurs="0"/>
            <xs:element name="mqtt-sn" type="mqttsnConfigEntity" minOccurs="0"/>
            <xs:element name="restrictions" type="restrictionsEntity" minOccurs="0"/>
            <xs:element name="security" type="securityConfigEntity" minOccurs="0"/>
            <xs:element name="mqtt-bridges" type="bridgesEntity" minOccurs="0"/>
            <xs:element name="admin-api" type="adminApiEntity" minOccurs="0"/>
            <xs:element name="persistence" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="mode" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>Default: in-memory</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                                <xs:restriction base="xs:string">
                                    <xs:enumeration value="file-native"/>
                                    <xs:enumeration value="file"/>
                                    <xs:enumeration value="in-memory"/>
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="protocol-adapters" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:choice minOccurs="0" maxOccurs="unbounded">
                            <xs:any processContents="skip"/>
                        </xs:choice>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="data-combiners" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:choice minOccurs="0" maxOccurs="unbounded">
                            <xs:any processContents="skip"/>
                        </xs:choice>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="asset-mappers" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:choice minOccurs="0" maxOccurs="unbounded">
                            <xs:any processContents="skip"/>
                        </xs:choice>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="tls-materials" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="tls-material" type="tlsMaterialEntity" minOccurs="0"
                                    maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="pulse" type="pulseEntity" minOccurs="0"/>
            <xs:element name="modules" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:choice minOccurs="0" maxOccurs="unbounded">
                            <xs:any processContents="skip"/>
                        </xs:choice>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="uns" type="unsEntity" minOccurs="0"/>
            <xs:element name="dynamic-configuration" type="dynamicConfigEntity" minOccurs="0"/>
            <xs:element name="usage-tracking" type="usageTrackingEntity" minOccurs="0"/>
            <xs:element name="internal" type="internalConfigEntity" minOccurs="0"/>
        </xs:all>
    </xs:complexType>

    <!-- Listeners -->
    <xs:complexType name="mqttListenersEntity">
        <xs:sequence>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element name="tcp-listener">
                    <xs:complexType>
                        <xs:all>
                            <xs:element name="port" type="port"/>
                            <xs:element name="bind-address" type="nonEmptyString" minOccurs="0">
                                <xs:annotation>
                                    <xs:documentation>Default: 0.0.0.0</xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="name" type="nonEmptyString" minOccurs="0"/>
                            <xs:element name="external-hostname" type="nonEmptyString" minOccurs="0"/>
                        </xs:all>
                    </xs:complexType>
                </xs:element>
                <xs:element name="tls-tcp-listener">
                    <xs:complexType>
                        <xs:all>
                            <xs:element name="port" type="port"/>
                            <xs:element name="bind-address" type="nonEmptyString" minOccurs="0">
                                <xs:annotation>
                                    <xs:documentation>Default: 0.0.0.0</xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="name" type="nonEmptyString" minOccurs="0"/>
                            <xs:element name="external-hostname" type="nonEmptyString" minOccurs="0"/>
                            <xs:element name="tls" type="listenerTLSEntity"/>
                        </xs:all>
                    </xs:complexType>
                </xs:element>
                <xs:element name="websocket-listener">
                    <xs:complexType mixed="true">
                        <xs:all>
                            <xs:element name="port" type="port"/>
                            <xs:element name="bind-address" type="nonEmptyString" minOccurs="0">
                                <xs:annotation>
                                    <xs:documentation>Default: 0.0.0.0</xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="name" type="nonEmptyString" minOccurs="0"/>
                            <xs:element name="external-hostname" type="nonEmptyString" minOccurs="0"/>
                            <xs:element name="path" type="nonEmptyString" minOccurs="0">
                                <xs:annotation>
                                    <xs:documentation>Default: /mqtt</xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="subprotocols" minOccurs="0">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="subprotocol" type="nonEmptyString" minOccurs="0"
                                                    maxOccurs="unbounded"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="allow-extensions" type="xs:boolean" minOccurs="0">
                                <xs:annotation>
                                    <xs:documentation>Default: false</xs:documentation>
                                </xs:annotation>
                            </xs:element>
                        </xs:all>
                    </xs:complexType>
                </xs:element>
                <xs:element name="tls-websocket-listener">
                    <xs:complexType>
                        <xs:all>
                            <xs:element name="port" type="port"/>
                            <xs:element name="bind-address" type="nonEmptyString" minOccurs="0">
                                <xs:annotation>
                                    <xs:documentation>Default: 0.0.0.0</xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="name" type="nonEmptyString" minOccurs="0"/>
                            <xs:element name="external-hostname" type="nonEmptyString" minOccurs="0"/>
                            <xs:element name="path" type="nonEmptyString" minOccurs="0">
                                <xs:annotation>
                                    <xs:documentation>Default: /mqtt</xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="subprotocols" minOccurs="0">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="subprotocol" type="nonEmptyString" minOccurs="0"
                                                    maxOccurs="unbounded"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="allow-extensions" type="xs:boolean" minOccurs="0">
                                <xs:annotation>
                                    <xs:documentation>Default: false</xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="tls" type="listenerTLSEntity"/>
                        </xs:all>
                    </xs:complexType>
                </xs:element>
            </xs:choice>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="mqttsnListenersEntity">
        <xs:sequence>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element name="udp-listener">
                    <xs:complexType>
                        <xs:all>
                            <xs:element name="port" type="port"/>
                            <xs:element name="bind-address" type="nonEmptyString" minOccurs="0">
                                <xs:annotation>
                                    <xs:documentation>Default: 0.0.0.0</xs:documentation>
                                </xs:annotation>
                            </xs:element>
                            <xs:element name="name" type="nonEmptyString" minOccurs="0"/>
                            <xs:element name="external-hostname" type="nonEmptyString" minOccurs="0"/>
                        </xs:all>
                    </xs:complexType>
                </xs:element>
            </xs:choice>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="listenerTLSEntity">
        <xs:all>
            <xs:element name="keystore" type="keystoreEntity"/>
            <xs:element name="truststore" type="truststoreEntity" minOccurs="0"/>
            <xs:element name="protocols" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="protocol" type="nonEmptyString" minOccurs="0" maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="cipher-suites" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="cipher-suite" type="nonEmptyString" minOccurs="0" maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="prefer-server-cipher-suites" type="xs:boolean" minOccurs="0"/>
            <xs:element name="handshake-timeout" type="xs:positiveInteger" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Timeout in milliseconds. Default: 10000</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="client-authentication-mode" type="clientAuthenticationMode" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Default: NONE</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:all>
    </xs:complexType>

    <!-- MQTT -->
    <xs:complexType name="mqttConfigEntity">
        <xs:all>
            <xs:element name="queued-messages" minOccurs="0">
                <xs:complexType>
                    <xs:all>
                        <xs:element name="max-queue-size" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>Default: 1000</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                                <xs:restriction base="xs:long">
                                    <xs:minInclusive value="1"/>
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:element>
                        <xs:element name="strategy" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>Default: discard</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                                <xs:restriction base="xs:string">
                                    <xs:enumeration value="discard"/>
                                    <xs:enumeration value="discard-oldest"/>
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:element>
                    </xs:all>
                </xs:complexType>
            </xs:element>
            <xs:element name="retained-messages" minOccurs="0">
                <xs:complexType>
                    <xs:all>
                        <xs:element name="enabled" type="xs:boolean" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>Default: true</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                    </xs:all>
                </xs:complexType>
            </xs:element>
            <xs:element name="wildcard-subscriptions" minOccurs="0">
                <xs:complexType>
                    <xs:all>
                        <xs:element name="enabled" type="xs:boolean" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>Default: true</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                    </xs:all>
                </xs:complexType>
            </xs:element>
            <xs:element name="quality-of-service" minOccurs="0">
                <xs:complexType>
                    <xs:all>
                        <xs:element name="max-qos" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>Default: 2</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                                <xs:restriction base="xs:int">
                                    <xs:enumeration value="0"/>
                                    <xs:enumeration value="1"/>
                                    <xs:enumeration value="2"/>
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:element>
                    </xs:all>
                </xs:complexType>
            </xs:element>
            <xs:element name="topic-alias" minOccurs="0">
                <xs:complexType>
                    <xs:all>
                        <xs:element name="enabled" type="xs:boolean" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>Default: true</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="max-per-client" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>Default: 5</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                                <xs:restriction base="xs:int">
                                    <xs:minInclusive value="1"/>
                                    <xs:maxInclusive value="65535"/>
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:element>
                    </xs:all>
                </xs:complexType>
            </xs:element>
            <xs:element name="message-expiry" minOccurs="0">
                <xs:complexType>
                    <xs:all>
                        <xs:element name="max-interval" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>Interval in seconds. Default: 4294967296</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                                <xs:restriction base="xs:long">
                                    <xs:minInclusive value="0"/>
                                    <xs:maxInclusive value="4294967296"/>
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:element>
                    </xs:all>
                </xs:complexType>
            </xs:element>
            <xs:element name="session-expiry" minOccurs="0">
                <xs:complexType>
                    <xs:all>
                        <xs:element name="max-interval" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>Interval in seconds. Default: 4294967296</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                                <xs:restriction base="xs:long">
                                    <xs:minInclusive value="0"/>
                                    <xs:maxInclusive value="4294967295"/>
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:element>
                    </xs:all>
                </xs:complexType>
            </xs:element>
            <xs:element name="subscription-identifier" minOccurs="0">
                <xs:complexType>
                    <xs:all>
                        <xs:element name="enabled" type="xs:boolean" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>Default: true</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                    </xs:all>
                </xs:complexType>
            </xs:element>
            <xs:element name="shared-subscriptions" minOccurs="0">
                <xs:complexType>
                    <xs:all>
                        <xs:element name="enabled" type="xs:boolean" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>Default: true</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                    </xs:all>
                </xs:complexType>
            </xs:element>
            <xs:element name="keep-alive" minOccurs="0">
                <xs:complexType>
                    <xs:all>
                        <xs:element name="max-keep-alive" minOccurs="0">
                            <xs:simpleType>
                                <xs:annotation>
                                    <xs:documentation>Keep-alive in seconds. Default: 65535</xs:documentation>
                                </xs:annotation>
                                <xs:restriction base="xs:int">
                                    <xs:minInclusive value="1"/>
                                    <xs:maxInclusive value="65535"/>
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:element>
                        <xs:element name="allow-unlimited" type="xs:boolean" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>Default: true</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                    </xs:all>
                </xs:complexType>
            </xs:element>
            <xs:element name="packets" minOccurs="0">
                <xs:complexType>
                    <xs:all>
                        <xs:element name="max-packet-size" minOccurs="0">
                            <xs:simpleType>
                                <xs:annotation>
                                    <xs:documentation>Size in bytes. Default: 268435460</xs:documentation>
                                </xs:annotation>
                                <xs:restriction base="xs:int">
                                    <xs:minInclusive value="15"/>
                                    <xs:maxInclusive value="268435460"/>
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:element>
                    </xs:all>
                </xs:complexType>
            </xs:element>
            <xs:element name="receive-maximum" minOccurs="0">
                <xs:complexType>
                    <xs:all>
                        <xs:element name="server-receive-maximum" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>Default: 10</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                                <xs:restriction base="xs:int">
                                    <xs:minInclusive value="1"/>
                                    <xs:maxInclusive value="65535"/>
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:element>
                    </xs:all>
                </xs:complexType>
            </xs:element>
        </xs:all>
    </xs:complexType>

    <!-- MQTT-SN -->
    <xs:complexType name="mqttsnConfigEntity">
        <xs:all>
            <xs:element name="gateway-id" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Default: 1</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="xs:int">
                        <xs:minInclusive value="1"/>
                        <xs:maxInclusive value="65535"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="predefined-topics" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="predefined-topic" maxOccurs="unbounded" minOccurs="0">
                            <xs:complexType>
                                <xs:sequence>
                                    <xs:element type="xs:string" name="topicName"/>
                                    <xs:element type="xs:int" name="alias"/>
                                </xs:sequence>
                            </xs:complexType>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="allow-empty-client-identifier" minOccurs="0">
                <xs:complexType>
                    <xs:all>
                        <xs:element name="enabled" type="xs:boolean" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>Default: false</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                    </xs:all>
                </xs:complexType>
            </xs:element>
            <xs:element name="allow-anonymous-publish-minus-one" minOccurs="0">
                <xs:complexType>
                    <xs:all>
                        <xs:element name="enabled" type="xs:boolean" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>Default: false</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                    </xs:all>
                </xs:complexType>
            </xs:element>
            <xs:element name="allow-waking-ping-session-hijack" minOccurs="0">
                <xs:complexType>
                    <xs:all>
                        <xs:element name="enabled" type="xs:boolean" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>Default: false</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                    </xs:all>
                </xs:complexType>
            </xs:element>
            <xs:element name="topic-registrations-held-during-sleep" minOccurs="0">
                <xs:complexType>
                    <xs:all>
                        <xs:element name="enabled" type="xs:boolean" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>Default: false</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                    </xs:all>
                </xs:complexType>
            </xs:element>
            <xs:element name="max-client-identifier-length" minOccurs="0">
                <xs:simpleType>
                    <xs:annotation>
                        <xs:documentation>Size in bytes. Default: 23</xs:documentation>
                    </xs:annotation>
                    <xs:restriction base="xs:int">
                        <xs:minInclusive value="0"/>
                        <xs:maxInclusive value="65535"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="discovery" minOccurs="0">
                <xs:complexType>
                    <xs:all>
                        <xs:element name="enabled" type="xs:boolean" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>Default: false</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="discovery-interval-seconds" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>Default: 65535</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                                <xs:restriction base="xs:int">
                                    <xs:minInclusive value="1"/>
                                    <xs:maxInclusive value="65535"/>
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:element>
                        <xs:element name="broadcast-addresses" minOccurs="0">
                            <xs:complexType>
                                <xs:all>
                                    <xs:element name="address" minOccurs="0">
                                        <xs:complexType>
                                            <xs:all>
                                                <xs:element name="port" type="port"/>
                                                <xs:element name="bind-address" type="nonEmptyString" minOccurs="0">
                                                    <xs:annotation>
                                                        <xs:documentation>Default: 0.0.0.0</xs:documentation>
                                                    </xs:annotation>
                                                </xs:element>
                                                <xs:element name="name" type="nonEmptyString" minOccurs="0"/>
                                            </xs:all>
                                        </xs:complexType>
                                    </xs:element>
                                </xs:all>
                            </xs:complexType>
                        </xs:element>
                    </xs:all>
                </xs:complexType>
            </xs:element>
        </xs:all>
    </xs:complexType>

    <!-- Restrictions -->
    <xs:complexType name="restrictionsEntity">
        <xs:all>
            <xs:element name="max-connections" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>
                        -1 means unlimited. License limitations still apply. Default: -1
                    </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="xs:long">
                        <xs:minInclusive value="-1"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="max-client-id-length" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Default: 65535</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="xs:int">
                        <xs:minInclusive value="1"/>
                        <xs:maxInclusive value="65535"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="max-topic-length" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Default: 65535</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="xs:int">
                        <xs:minInclusive value="1"/>
                        <xs:maxInclusive value="65535"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="no-connect-idle-timeout" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Timeout in milliseconds. Default: 10000</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="xs:int">
                        <xs:minInclusive value="0"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="incoming-bandwidth-throttling" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Throttling in bytes per seconds. Default: 0</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="xs:long">
                        <xs:minInclusive value="0"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="max-topic-filters-per-packet" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>
                        Topic filters one SUBSCRIBE or UNSUBSCRIBE may carry. A client that sends more is
                        disconnected. Default: 10000
                    </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="xs:int">
                        <xs:minInclusive value="1"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="max-incoming-qos2-flows" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>
                        Inbound QoS 2 messages, across all clients, whose PUBREL has not arrived yet. Over the
                        limit, a new QoS 2 PUBLISH is refused: MQTT 5 with PUBREC 0x97, MQTT 3 by closing the
                        connection. Default: 100000
                    </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="xs:long">
                        <xs:minInclusive value="1"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="max-incoming-qos2-flows-per-client" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>
                        Inbound QoS 2 messages one client may have whose PUBREL has not arrived yet, kept across
                        its reconnects. Over the limit, the client's new QoS 2 PUBLISH is refused as for
                        max-incoming-qos2-flows, so that one client cannot hold the node's limit. Default: 1000
                    </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="xs:int">
                        <xs:minInclusive value="1"/>
                        <xs:maxInclusive value="65535"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
        </xs:all>
    </xs:complexType>

    <!-- Security -->
    <xs:complexType name="securityConfigEntity">
        <xs:all>
            <xs:element name="payload-format-validation" minOccurs="0">
                <xs:complexType>
                    <xs:all>
                        <xs:element name="enabled" type="xs:boolean" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>Default: false</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                    </xs:all>
                </xs:complexType>
            </xs:element>
            <xs:element name="utf8-validation" minOccurs="0">
                <xs:complexType>
                    <xs:all>
                        <xs:element name="enabled" type="xs:boolean" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>Default: true</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                    </xs:all>
                </xs:complexType>
            </xs:element>
            <xs:element name="allow-empty-client-id" minOccurs="0">
                <xs:complexType>
                    <xs:all>
                        <xs:element name="enabled" type="xs:boolean" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>Default: true</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                    </xs:all>
                </xs:complexType>
            </xs:element>
            <xs:element name="allow-request-problem-information" minOccurs="0">
                <xs:complexType>
                    <xs:all>
                        <xs:element name="enabled" type="xs:boolean" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>Default: true</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                    </xs:all>
                </xs:complexType>
            </xs:element>
        </xs:all>
    </xs:complexType>

    <!-- MQTT Bridges -->
    <xs:complexType name="bridgesEntity">
        <xs:sequence>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element name="mqtt-bridge">
                    <xs:complexType>
                        <xs:all>
                            <xs:element name="id">
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:minLength value="1"/>
                                        <xs:whiteSpace value="collapse"/>
                                        <xs:pattern value="[a-zA-Z0-9_\-]+"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="remote-broker">
                                <xs:complexType>
                                    <xs:all>
                                        <xs:element name="host" type="nonEmptyString"/>
                                        <xs:element name="port" type="port" minOccurs="0">
                                            <xs:annotation>
                                                <xs:documentation>Default: 1883</xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element name="websocket" minOccurs="0">
                                            <xs:complexType>
                                                <xs:all>
                                                    <xs:element name="enabled" type="xs:boolean"/>
                                                    <xs:element name="server-path" type="xs:string" minOccurs="0"/>
                                                    <xs:element name="subprotocol" type="xs:string" minOccurs="0"/>
                                                </xs:all>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="mqtt" minOccurs="0">
                                            <xs:complexType>
                                                <xs:all>
                                                    <xs:element name="client-id" type="xs:string" minOccurs="0"/>
                                                    <xs:element name="clean-start" type="xs:boolean" minOccurs="0"/>
                                                    <xs:element name="session-expiry" minOccurs="0">
                                                        <xs:annotation>
                                                            <xs:documentation>Session Expiry Interval in seconds.
                                                                Default: 3600
                                                            </xs:documentation>
                                                        </xs:annotation>
                                                        <xs:simpleType>
                                                            <xs:restriction base="xs:long">
                                                                <xs:minInclusive value="0"/>
                                                                <xs:maxInclusive value="4294967295"/>
                                                            </xs:restriction>
                                                        </xs:simpleType>
                                                    </xs:element>
                                                    <xs:element name="keep-alive" minOccurs="0">
                                                        <xs:simpleType>
                                                            <xs:annotation>
                                                                <xs:documentation>Keep-alive in seconds. Default: 60
                                                                </xs:documentation>
                                                            </xs:annotation>
                                                            <xs:restriction base="xs:int">
                                                                <xs:minInclusive value="0"/>
                                                                <xs:maxInclusive value="65535"/>
                                                            </xs:restriction>
                                                        </xs:simpleType>
                                                    </xs:element>

                                                </xs:all>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="authentication" minOccurs="0">
                                            <xs:complexType>
                                                <xs:choice>
                                                    <xs:element name="mqtt-simple-authentication" minOccurs="0">
                                                        <xs:complexType>
                                                            <xs:all>
                                                                <xs:element name="username" type="xs:string"/>
                                                                <xs:element name="password" type="xs:string"/>
                                                            </xs:all>
                                                        </xs:complexType>
                                                    </xs:element>
                                                </xs:choice>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="tls" minOccurs="0">
                                            <xs:complexType>
                                                <xs:all>
                                                    <xs:element name="enabled" type="xs:boolean"/>
                                                    <xs:element name="keystore" type="keystoreEntity" minOccurs="0"/>
                                                    <xs:element name="truststore" type="truststoreEntity"
                                                                minOccurs="0"/>
                                                    <xs:element name="protocols" minOccurs="0">
                                                        <xs:complexType>
                                                            <xs:sequence>
                                                                <xs:element name="protocol" type="nonEmptyString"
                                                                            minOccurs="0" maxOccurs="unbounded"/>
                                                            </xs:sequence>
                                                        </xs:complexType>
                                                    </xs:element>
                                                    <xs:element name="cipher-suites" minOccurs="0">
                                                        <xs:complexType>
                                                            <xs:sequence>
                                                                <xs:element name="cipher-suite" type="nonEmptyString"
                                                                            minOccurs="0" maxOccurs="unbounded"/>
                                                            </xs:sequence>
                                                        </xs:complexType>
                                                    </xs:element>
                                                    <xs:element name="verify-hostname" type="xs:boolean" minOccurs="0"/>
                                                    <xs:element name="handshake-timeout" minOccurs="0">
                                                        <xs:annotation>
                                                            <xs:documentation>TLS Handshake timeout in seconds. Default:
                                                                10.
                                                            </xs:documentation>
                                                        </xs:annotation>
                                                        <xs:simpleType>
                                                            <xs:restriction base="xs:int">
                                                                <xs:minInclusive value="1"/>
                                                                <xs:maxInclusive value="2147483647"/>
                                                            </xs:restriction>
                                                        </xs:simpleType>
                                                    </xs:element>

                                                    <!-- The superseding spelling. The four material elements reuse
                                                         the types the shared tls-material block declares, so one
                                                         definition serves both places an operator may write them.
                                                         Mutually exclusive with keystore and truststore, which the
                                                         schema cannot express and the effective-configuration stage
                                                         refuses. -->
                                                    <xs:element name="tls-checks" type="bridgeTlsPreset"
                                                                minOccurs="0"/>
                                                    <xs:element name="tls-checks-full" type="bridgeTlsChecksEntity"
                                                                minOccurs="0"/>
                                                    <xs:element name="tls-identity" type="tlsIdentityEntity"
                                                                minOccurs="0"/>
                                                    <xs:element name="tls-truststore" type="tlsTruststoreEntity" minOccurs="0">
                                                        <xs:unique name="bridgeTlsTruststoreSingleValues">
                                                            <xs:selector xpath="."/>
                                                            <xs:field xpath="name"/>
                                                            <xs:field xpath="uuid"/>
                                                            <xs:field xpath="reference-name"/>
                                                            <xs:field xpath="reference-uuid"/>
                                                            <xs:field xpath="format"/>
                                                            <xs:field xpath="password"/>
                                                            <xs:field xpath="password-file"/>
                                                            <xs:field xpath="skip-integrity-check"/>
                                                        </xs:unique>
                                                    </xs:element>
                                                    <xs:element name="tls-allowlist" type="tlsAllowlistEntity" minOccurs="0">
                                                        <xs:unique name="bridgeTlsAllowlistSingleValues">
                                                            <xs:selector xpath="."/>
                                                            <xs:field xpath="name"/>
                                                            <xs:field xpath="uuid"/>
                                                            <xs:field xpath="reference-name"/>
                                                            <xs:field xpath="reference-uuid"/>
                                                        </xs:unique>
                                                    </xs:element>
                                                    <xs:element name="tls-revocationlist" type="tlsRevocationlistEntity" minOccurs="0">
                                                        <xs:unique name="bridgeTlsRevocationlistSingleValues">
                                                            <xs:selector xpath="."/>
                                                            <xs:field xpath="name"/>
                                                            <xs:field xpath="uuid"/>
                                                            <xs:field xpath="reference-name"/>
                                                            <xs:field xpath="reference-uuid"/>
                                                        </xs:unique>
                                                    </xs:element>
                                                </xs:all>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:all>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="remote-subscriptions" minOccurs="0">
                                <xs:complexType>
                                    <xs:choice>
                                        <xs:element name="remote-subscription" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:all>
                                                    <xs:element name="filters">
                                                        <xs:complexType>
                                                            <xs:choice>
                                                                <xs:element name="mqtt-topic-filter"
                                                                            type="nonEmptyString" minOccurs="0"
                                                                            maxOccurs="unbounded"/>
                                                            </xs:choice>
                                                        </xs:complexType>
                                                    </xs:element>
                                                    <xs:element name="max-qos" minOccurs="0">
                                                        <xs:annotation>
                                                            <xs:documentation>Default: 2</xs:documentation>
                                                        </xs:annotation>
                                                        <xs:simpleType>
                                                            <xs:restriction base="xs:int">
                                                                <xs:enumeration value="0"/>
                                                                <xs:enumeration value="1"/>
                                                                <xs:enumeration value="2"/>
                                                            </xs:restriction>
                                                        </xs:simpleType>
                                                    </xs:element>
                                                    <xs:element name="preserve-retain" type="xs:boolean" minOccurs="0"/>
                                                    <xs:element name="destination" type="nonEmptyString" minOccurs="0"/>
                                                    <xs:element name="custom-user-properties" minOccurs="0">
                                                        <xs:complexType>
                                                            <xs:choice>
                                                                <xs:element name="user-property" minOccurs="0"
                                                                            maxOccurs="unbounded">
                                                                    <xs:complexType>
                                                                        <xs:all>
                                                                            <xs:element name="key"
                                                                                        type="nonEmptyString"/>
                                                                            <xs:element name="value"
                                                                                        type="nonEmptyString"/>
                                                                        </xs:all>
                                                                    </xs:complexType>
                                                                </xs:element>
                                                            </xs:choice>
                                                        </xs:complexType>
                                                    </xs:element>
                                                </xs:all>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:choice>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="forwarded-topics" minOccurs="0">
                                <xs:complexType>
                                    <xs:choice>
                                        <xs:element name="forwarded-topic" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:all>
                                                    <xs:element name="filters">
                                                        <xs:complexType>
                                                            <xs:choice>
                                                                <xs:element name="mqtt-topic-filter"
                                                                            type="nonEmptyString"
                                                                            maxOccurs="unbounded"/>
                                                            </xs:choice>
                                                        </xs:complexType>
                                                    </xs:element>
                                                    <xs:element name="max-qos" minOccurs="0">
                                                        <xs:annotation>
                                                            <xs:documentation>Default: 2</xs:documentation>
                                                        </xs:annotation>
                                                        <xs:simpleType>
                                                            <xs:restriction base="xs:int">
                                                                <xs:enumeration value="0"/>
                                                                <xs:enumeration value="1"/>
                                                                <xs:enumeration value="2"/>
                                                            </xs:restriction>
                                                        </xs:simpleType>
                                                    </xs:element>
                                                    <xs:element name="queue-limit" type="xs:int" minOccurs="0"/>
                                                    <xs:element name="preserve-retain" type="xs:boolean" minOccurs="0"/>
                                                    <xs:element name="destination" type="nonEmptyString" minOccurs="0"/>
                                                    <xs:element name="custom-user-properties" minOccurs="0">
                                                        <xs:complexType>
                                                            <xs:choice>
                                                                <xs:element name="user-property" minOccurs="0"
                                                                            maxOccurs="unbounded">
                                                                    <xs:complexType>
                                                                        <xs:all>
                                                                            <xs:element name="key"
                                                                                        type="nonEmptyString"/>
                                                                            <xs:element name="value"
                                                                                        type="nonEmptyString"/>
                                                                        </xs:all>
                                                                    </xs:complexType>
                                                                </xs:element>
                                                            </xs:choice>
                                                        </xs:complexType>
                                                    </xs:element>
                                                    <xs:element name="excludes" minOccurs="0">
                                                        <xs:complexType>
                                                            <xs:choice>
                                                                <xs:element name="mqtt-topic-filter"
                                                                            type="nonEmptyString" minOccurs="0"
                                                                            maxOccurs="unbounded"/>
                                                            </xs:choice>
                                                        </xs:complexType>
                                                    </xs:element>
                                                </xs:all>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:choice>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="loop-prevention" minOccurs="0">
                                <xs:complexType>
                                    <xs:all>
                                        <xs:element name="hop-count-limit" type="xs:positiveInteger" minOccurs="0">
                                            <xs:annotation>
                                                <xs:documentation>Limit of maximum bridge hops until a message is not
                                                    forwarded anymore.
                                                    Default: 1
                                                </xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element name="enabled" type="xs:boolean" minOccurs="0"/>
                                    </xs:all>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="persist" minOccurs="0">
                                <xs:simpleType>
                                    <xs:restriction base="xs:boolean">
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                        </xs:all>
                    </xs:complexType>
                </xs:element>
            </xs:choice>
        </xs:sequence>
    </xs:complexType>

    <!-- Admin API -->
    <xs:complexType name="adminApiEntity">
        <xs:all>
            <xs:element name="enabled" type="xs:boolean" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Default: true</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="listeners" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:choice minOccurs="0" maxOccurs="unbounded">
                            <xs:element name="http-listener">
                                <xs:complexType>
                                    <xs:all>
                                        <xs:element name="port" type="port"/>
                                        <xs:element name="bind-address" type="nonEmptyString" minOccurs="0">
                                            <xs:annotation>
                                                <xs:documentation>Default: 0.0.0.0</xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                    </xs:all>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="https-listener">
                                <xs:complexType>
                                    <xs:all>
                                        <xs:element name="port" type="port"/>
                                        <xs:element name="bind-address" type="nonEmptyString" minOccurs="0">
                                            <xs:annotation>
                                                <xs:documentation>Default: 0.0.0.0</xs:documentation>
                                            </xs:annotation>
                                        </xs:element>
                                        <xs:element name="tls">
                                            <xs:complexType>
                                                <xs:all>
                                                    <xs:element name="keystore" type="keystoreEntity"/>
                                                    <xs:element name="protocols" minOccurs="0">
                                                        <xs:complexType>
                                                            <xs:sequence>
                                                                <xs:element name="protocol" type="nonEmptyString"
                                                                            minOccurs="0" maxOccurs="unbounded"/>
                                                            </xs:sequence>
                                                        </xs:complexType>
                                                    </xs:element>
                                                    <xs:element name="cipher-suites" minOccurs="0">
                                                        <xs:complexType>
                                                            <xs:sequence>
                                                                <xs:element name="cipher-suite" type="nonEmptyString"
                                                                            minOccurs="0" maxOccurs="unbounded"/>
                                                            </xs:sequence>
                                                        </xs:complexType>
                                                    </xs:element>
                                                </xs:all>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:all>
                                </xs:complexType>
                            </xs:element>
                        </xs:choice>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="generated-tokens" minOccurs="0">
                <xs:complexType>
                    <xs:all>
                        <xs:element name="keySize" type="xs:string"/>
                        <xs:element name="issuer" type="xs:string"/>
                        <xs:element name="audience" type="xs:string"/>
                        <xs:element name="expiryTimeMinutes" type="xs:int"/>
                        <xs:element name="tokenEarlyEpochThresholdMinutes" type="xs:int"/>
                    </xs:all>
                </xs:complexType>
            </xs:element>
            <xs:element name="users" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="user" minOccurs="0" maxOccurs="unbounded">
                            <xs:complexType>
                                <xs:all>
                                    <xs:element name="username" type="xs:string"/>
                                    <xs:element name="password" type="xs:string"/>
                                    <xs:element name="roles">
                                        <xs:complexType>
                                            <xs:choice minOccurs="0" maxOccurs="unbounded">
                                                <xs:element name="role" minOccurs="0" maxOccurs="unbounded"
                                                            type="xs:string"/>
                                            </xs:choice>
                                        </xs:complexType>
                                    </xs:element>
                                </xs:all>
                            </xs:complexType>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="ldap" minOccurs="0" maxOccurs="1">
                <xs:complexType>
                    <xs:all>
                        <xs:element name="servers" minOccurs="1" maxOccurs="1">
                            <xs:complexType>
                                <xs:sequence>
                                    <xs:element name="ldap-server" minOccurs="1" maxOccurs="unbounded">
                                        <xs:annotation>
                                            <xs:documentation>
                                                LDAP server to authenticate against. Several may be given; connections
                                                are distributed over them round-robin.
                                            </xs:documentation>
                                        </xs:annotation>
                                        <xs:complexType>
                                            <xs:all>
                                                <xs:element name="host" type="nonEmptyString"/>
                                                <xs:element name="port" type="port" minOccurs="0">
                                                    <xs:annotation>
                                                        <xs:documentation>LDAP server port. If not specified, defaults to 389 for NONE/START_TLS or 636 for LDAPS.</xs:documentation>
                                                    </xs:annotation>
                                                </xs:element>
                                            </xs:all>
                                        </xs:complexType>
                                    </xs:element>
                                </xs:sequence>
                            </xs:complexType>
                        </xs:element>
                        <xs:element name="tls-mode" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>TLS mode for LDAP connection. Default: NONE</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                                <xs:restriction base="xs:string">
                                    <xs:enumeration value="NONE"/>
                                    <xs:enumeration value="LDAPS"/>
                                    <xs:enumeration value="START_TLS"/>
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:element>
                        <xs:element name="tls" minOccurs="0">
                            <xs:complexType>
                                <xs:all>
                                    <xs:element name="truststore-path" type="nonEmptyString" minOccurs="0">
                                        <xs:annotation>
                                            <xs:documentation>Path to truststore file. If not specified, system default CA certificates are used.</xs:documentation>
                                        </xs:annotation>
                                    </xs:element>
                                    <xs:element name="truststore-password" type="xs:string" minOccurs="0">
                                        <xs:annotation>
                                            <xs:documentation>Password for the truststore.</xs:documentation>
                                        </xs:annotation>
                                    </xs:element>
                                    <xs:element name="truststore-type" type="xs:string" minOccurs="0">
                                        <xs:annotation>
                                            <xs:documentation>Type of truststore (e.g., JKS, PKCS12).</xs:documentation>
                                        </xs:annotation>
                                    </xs:element>
                                </xs:all>
                            </xs:complexType>
                        </xs:element>
                        <xs:element name="simple-bind" minOccurs="1" maxOccurs="1">
                            <xs:complexType>
                                <xs:all>
                                    <xs:element name="rdns" type="nonEmptyString"/>
                                    <xs:element name="userPassword" type="nonEmptyString"/>
                                </xs:all>
                            </xs:complexType>
                        </xs:element>
                        <xs:element name="connect-timeout-millis" type="xs:nonNegativeInteger" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>Connection timeout in milliseconds. 0 means use SDK default.</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="response-timeout-millis" type="xs:nonNegativeInteger" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>Response timeout in milliseconds. 0 means use SDK default.</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="search-timeout-seconds" type="xs:nonNegativeInteger" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>Timeout for search requests.</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="max-connections" type="xs:nonNegativeInteger" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>Max number of connections open in the connection pool.</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="uid-attribute" type="nonEmptyString" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>Attribute for the user id. Example: uid</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="rdns" type="nonEmptyString">
                            <xs:annotation>
                                <xs:documentation>
                                    Relative Distinguished Names for user searches.
                                    Legacy mode (no base-dn): treated as absolute DN.
                                    New mode (base-dn specified): relative to base-dn.
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="base-dn" type="nonEmptyString" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>
                                    Optional base Distinguished Name. When specified, both rdns and service account
                                    rdns are relative to this base DN. This allows service accounts in different OUs
                                    than users (e.g., service account in ou=system, users in ou=people).
                                    If not specified, legacy mode is used where rdns is absolute.
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="required-object-class" type="nonEmptyString" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>An optional object class to check for retrieved entries.</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="directory-descent" type="xs:boolean" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>Enable directory descent instead of using direct binding.</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="user-roles" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation>Optional list of user roles with LDAP queries. Minimum 1, maximum 3 entries.</xs:documentation>
                            </xs:annotation>
                            <xs:complexType>
                                <xs:sequence>
                                    <xs:element name="user-role" minOccurs="1" maxOccurs="3">
                                        <xs:complexType>
                                            <xs:all>
                                                <xs:element name="role" type="nonEmptyString">
                                                    <xs:annotation>
                                                        <xs:documentation>The role name to assign.</xs:documentation>
                                                    </xs:annotation>
                                                </xs:element>
                                                <xs:element name="query" type="xs:string">
                                                    <xs:annotation>
                                                        <xs:documentation>The LDAP query for this role.</xs:documentation>
                                                    </xs:annotation>
                                                </xs:element>
                                            </xs:all>
                                        </xs:complexType>
                                    </xs:element>
                                </xs:sequence>
                            </xs:complexType>
                        </xs:element>
                    </xs:all>
                </xs:complexType>
            </xs:element>
            <xs:element name="pre-login-notice" minOccurs="0">
                <xs:complexType>
                    <xs:all>
                        <xs:element name="enabled" type="xs:boolean" default="false"/>
                        <xs:element name="title" type="xs:string" minOccurs="0"/>
                        <xs:element name="message" type="xs:string" minOccurs="0"/>
                        <xs:element name="consent" type="xs:string" minOccurs="0"/>
                    </xs:all>
                </xs:complexType>
            </xs:element>
            <xs:element name="oidc-authentication" minOccurs="0" maxOccurs="1">
                <xs:complexType>
                    <xs:all>
                        <xs:element name="enabled" type="xs:boolean"/>
                        <xs:element name="issuer-uri" type="xs:string" minOccurs="0"/>
                        <xs:element name="client-id" type="xs:string" minOccurs="0"/>
                        <xs:element name="client-secret" type="nonEmptyString" minOccurs="0"/>
                        <xs:element name="redirect-uri" type="xs:string" minOccurs="0"/>
                        <xs:element name="role-claim-name" type="xs:string" minOccurs="0" default="roles"/>
                        <xs:element name="extra-scopes" minOccurs="0">
                            <xs:complexType>
                                <xs:sequence>
                                    <xs:element name="extra-scope"
                                                type="nonEmptyString"
                                                minOccurs="1"
                                                maxOccurs="unbounded"/>
                                </xs:sequence>
                            </xs:complexType>
                        </xs:element>
                        <xs:element name="role-mappings" minOccurs="0">
                            <xs:complexType>
                                <xs:sequence>
                                    <xs:element name="role-mapping" minOccurs="0" maxOccurs="unbounded">
                                        <xs:complexType>
                                            <xs:all>
                                                <xs:element name="idp-role" type="xs:string"/>
                                                <xs:element name="edge-role" type="xs:string"/>
                                            </xs:all>
                                        </xs:complexType>
                                    </xs:element>
                                </xs:sequence>
                            </xs:complexType>
                        </xs:element>
                        <xs:element name="id-token-signing-algorithms" minOccurs="0">
                            <xs:complexType>
                                <xs:sequence>
                                    <xs:element name="id-token-signing-algorithm"
                                                type="nonEmptyString"
                                                minOccurs="1"
                                                maxOccurs="unbounded"/>
                                </xs:sequence>
                            </xs:complexType>
                        </xs:element>
                        <xs:element name="truststore" minOccurs="0">
                            <xs:complexType>
                                <xs:all>
                                    <xs:element name="truststore-path" type="nonEmptyString" minOccurs="0">
                                        <xs:annotation>
                                            <xs:documentation>Path to the truststore holding the CA that signs the Identity Provider certificate. If not specified, the system default CA certificates are used.</xs:documentation>
                                        </xs:annotation>
                                    </xs:element>
                                    <xs:element name="truststore-password" type="xs:string" minOccurs="0">
                                        <xs:annotation>
                                            <xs:documentation>Password for the truststore.</xs:documentation>
                                        </xs:annotation>
                                    </xs:element>
                                    <xs:element name="truststore-type" type="xs:string" minOccurs="0">
                                        <xs:annotation>
                                            <xs:documentation>Type of truststore (e.g., JKS, PKCS12).</xs:documentation>
                                        </xs:annotation>
                                    </xs:element>
                                </xs:all>
                            </xs:complexType>
                        </xs:element>
                        <xs:element name="connection-timeout-millis" minOccurs="0" default="5000">
                            <xs:annotation>
                                <xs:documentation>Timeout in milliseconds for each connection to the Identity Provider (discovery, token exchange, and signing keys). The default of 5000 assumes a good connection; raise it for an Identity Provider behind a slow or distant network path. The minimum is 100; a smaller value is almost always a milliseconds/seconds mix-up that would make every login time out.</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                                <xs:restriction base="xs:int">
                                    <xs:minInclusive value="100"/>
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:element>
                    </xs:all>
                </xs:complexType>
            </xs:element>
            <xs:element name="username-authentication" minOccurs="0" maxOccurs="1">
                <xs:complexType>
                    <xs:all>
                        <xs:element name="enabled" type="xs:boolean"/>
                    </xs:all>
                </xs:complexType>
            </xs:element>
            <xs:element name="enforce-api-auth" type="xs:boolean" minOccurs="0" maxOccurs="1" default="true"/>
        </xs:all>
    </xs:complexType>
    <xs:complexType name="unsEntity">
        <xs:all>
            <xs:element name="isa95" type="isa95Entity" minOccurs="0"/>
            <xs:element name="isa88" type="isa88Entity" minOccurs="0"/>
        </xs:all>
    </xs:complexType>
    <xs:complexType name="isa95Entity">
        <xs:all>
            <xs:element name="enabled" type="xs:boolean" minOccurs="0"/>
            <xs:element name="prefix-all-topics" type="xs:boolean" minOccurs="0"/>
            <xs:element name="enterprise" type="xs:string" minOccurs="0"/>
            <xs:element name="site" type="xs:string" minOccurs="0"/>
            <xs:element name="area" type="xs:string" minOccurs="0"/>
            <xs:element name="production-line" type="xs:string" minOccurs="0"/>
            <xs:element name="work-cell" type="xs:string" minOccurs="0"/>
        </xs:all>
    </xs:complexType>
    <xs:complexType name="isa88Entity">
        <xs:all>
            <xs:element name="enabled" type="xs:boolean" minOccurs="0"/>
        </xs:all>
    </xs:complexType>
    <xs:complexType name="usageTrackingEntity">
        <xs:all>
            <xs:element name="enabled" type="xs:boolean" minOccurs="0"/>
        </xs:all>
    </xs:complexType>
    <xs:complexType name="dynamicConfigEntity">
        <xs:all>
            <xs:element name="allow-configuration-export" type="xs:boolean" minOccurs="0"/>
            <xs:element name="allow-mutable-configuration" type="xs:boolean" minOccurs="0"/>
        </xs:all>
    </xs:complexType>

    <!-- Bridge certificate validation Start -->

    <!-- A bridge's five independent validation checks. Five rather than six: MQTT sends no
         application identifier when it connects, so the check comparing one has no input here.
         Every element is optional and defaults to its strictest value, so an empty element means
         maximum validation. -->
    <xs:complexType name="bridgeTlsChecksEntity">
        <xs:all>
            <xs:element name="trust-mode" type="bridgeTlsTrustMode" minOccurs="0"/>
            <xs:element name="hostname" type="bridgeTlsHostnameCheck" minOccurs="0"/>
            <xs:element name="validity" type="bridgeTlsValidityCheck" minOccurs="0"/>
            <xs:element name="revocation" type="bridgeTlsRevocationCheck" minOccurs="0"/>
            <xs:element name="key-usage" type="bridgeTlsKeyUsageCheck" minOccurs="0"/>
        </xs:all>
    </xs:complexType>

    <!-- The check values are matched by the effective-configuration stage, which accepts them in
         any case and with the separators written or left out (a preset accepts a hyphen for an
         underscore), as the reference promises, and refuses any other word with a message listing
         the values. An enumeration here would refuse those variants before that stage reads them, so
         the schema checks only the shape and the documentation lists the values.

         Four presets plus the compatibility one. APPLICATION_URI is omitted, which without the
         application-identifier check would say nothing that chain trust alone does not.
         TLS_BRIDGE_DEFAULT is what a bridge writing no checks validates, named for why it exists
         because no name of reasonable length carries five values. -->
    <xs:simpleType name="bridgeTlsPreset">
        <xs:annotation>
            <xs:documentation>STANDARD, ALL, SELF_SIGNED, NO_VERIFICATION, TLS_BRIDGE_DEFAULT</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:token">
            <xs:pattern value="[A-Za-z]+([_\-][A-Za-z]+)*"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="bridgeTlsTrustMode">
        <xs:annotation>
            <xs:documentation>CHAIN, ALLOW_LIST, ANY_CERT</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:token">
            <xs:pattern value="[A-Za-z_\-]+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="bridgeTlsHostnameCheck">
        <xs:annotation>
            <xs:documentation>NONE, HOSTNAME</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:token">
            <xs:pattern value="[A-Za-z_\-]+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="bridgeTlsValidityCheck">
        <xs:annotation>
            <xs:documentation>NONE, NOT_BEFORE_OR_AFTER</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:token">
            <xs:pattern value="[A-Za-z_\-]+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="bridgeTlsRevocationCheck">
        <xs:annotation>
            <xs:documentation>NONE, CHECK, REQUIRE_CRLS</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:token">
            <xs:pattern value="[A-Za-z_\-]+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="bridgeTlsKeyUsageCheck">
        <xs:annotation>
            <xs:documentation>NONE, KEY_USAGE, SERVER_AUTH</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:token">
            <xs:pattern value="[A-Za-z_\-]+"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Bridge certificate validation End -->

    <!-- TLS material Start -->

    <!-- TLS material declared once for several surfaces to share. Repeats, so several parties can
         each manage their own material; a reference therefore names the material as well as the
         entry, written material-name::entry-name. A choice rather than a sequence, so an operator
         may group the four types however the deployment reads best. -->
    <xs:complexType name="tlsMaterialEntity">
        <xs:sequence>
            <xs:element name="name" type="xs:string" minOccurs="0"/>
            <xs:element name="uuid" type="xs:string" minOccurs="0"/>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element name="tls-identity" type="tlsIdentityEntity"/>
                <xs:element name="tls-truststore" type="tlsTruststoreEntity">
                    <xs:unique name="materialTlsTruststoreSingleValues">
                        <xs:selector xpath="."/>
                        <xs:field xpath="name"/>
                        <xs:field xpath="uuid"/>
                        <xs:field xpath="reference-name"/>
                        <xs:field xpath="reference-uuid"/>
                        <xs:field xpath="format"/>
                        <xs:field xpath="password"/>
                        <xs:field xpath="password-file"/>
                        <xs:field xpath="skip-integrity-check"/>
                    </xs:unique>
                </xs:element>
                <xs:element name="tls-allowlist" type="tlsAllowlistEntity">
                    <xs:unique name="materialTlsAllowlistSingleValues">
                        <xs:selector xpath="."/>
                        <xs:field xpath="name"/>
                        <xs:field xpath="uuid"/>
                        <xs:field xpath="reference-name"/>
                        <xs:field xpath="reference-uuid"/>
                    </xs:unique>
                </xs:element>
                <xs:element name="tls-revocationlist" type="tlsRevocationlistEntity">
                    <xs:unique name="materialTlsRevocationlistSingleValues">
                        <xs:selector xpath="."/>
                        <xs:field xpath="name"/>
                        <xs:field xpath="uuid"/>
                        <xs:field xpath="reference-name"/>
                        <xs:field xpath="reference-uuid"/>
                    </xs:unique>
                </xs:element>
            </xs:choice>
        </xs:sequence>
    </xs:complexType>

    <!-- A directory or glob pattern, with whether it may legitimately name no file. Two elements
         rather than an attribute, so the shape survives translation to JSON, YAML or Protobuf. -->
    <xs:complexType name="tlsFileLocationEntity">
        <xs:all>
            <xs:element name="location" type="xs:string"/>
            <xs:element name="may-be-empty" type="xs:boolean" minOccurs="0" default="false"/>
        </xs:all>
    </xs:complexType>

    <!-- Every element is optional, and deliberately so: one type describes this element both inside
         a tls-material, where it is a declaration, and inside a surface's tls element, where it may
         instead be a reference. What is required differs between the two, which a schema cannot
         express, so the resolving stage enforces it and names the element in its refusal. -->
    <xs:complexType name="tlsIdentityEntity">
        <xs:all>
            <xs:element name="name" type="xs:string" minOccurs="0"/>
            <xs:element name="uuid" type="xs:string" minOccurs="0"/>
            <xs:element name="reference-name" type="xs:string" minOccurs="0"/>
            <xs:element name="reference-uuid" type="xs:string" minOccurs="0"/>
            <xs:element name="format" type="tlsMaterialFormat" minOccurs="0"/>
            <xs:element name="file" type="xs:string" minOccurs="0"/>
            <xs:element name="key-file" type="xs:string" minOccurs="0"/>
            <xs:element name="certificate-file" type="xs:string" minOccurs="0"/>
            <xs:element name="chain-file" type="xs:string" minOccurs="0"/>
            <xs:element name="password" type="xs:string" minOccurs="0"/>
            <xs:element name="password-file" type="xs:string" minOccurs="0"/>
            <xs:element name="key-entry" type="xs:string" minOccurs="0"/>
            <xs:element name="keyentry-password" type="xs:string" minOccurs="0"/>
            <xs:element name="keyentry-password-file" type="xs:string" minOccurs="0"/>
            <xs:element name="key-password" type="xs:string" minOccurs="0"/>
            <xs:element name="key-password-file" type="xs:string" minOccurs="0"/>
        </xs:all>
    </xs:complexType>

    <!-- One unordered choice rather than a sequence, since the repeated file, directory, pattern and
         builtin elements merge into one set and an operator should not have to learn an order among
         them or against the password. A choice cannot say that the single-valued elements (name,
         reference, format, password, the integrity switch) appear at most once, and binding keeps only
         the last of two, so each element declaring this type, and the two list types below, carries
         an identity constraint whose fields are those elements: a field matching twice is a
         validation error. -->
    <xs:complexType name="tlsTruststoreEntity">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="name" type="xs:string"/>
            <xs:element name="uuid" type="xs:string"/>
            <xs:element name="reference-name" type="xs:string"/>
            <xs:element name="reference-uuid" type="xs:string"/>
            <xs:element name="format" type="tlsMaterialFormat"/>
            <xs:element name="file" type="xs:string"/>
            <xs:element name="directory" type="tlsFileLocationEntity"/>
            <xs:element name="pattern" type="tlsFileLocationEntity"/>
            <xs:element name="builtin" type="tlsBuiltinTruststore"/>
            <xs:element name="password" type="xs:string"/>
            <xs:element name="password-file" type="xs:string"/>
            <xs:element name="skip-integrity-check" type="xs:boolean"/>
        </xs:choice>
    </xs:complexType>

    <!-- No format element: the file is one hexadecimal fingerprint per line, with # comments. -->
    <xs:complexType name="tlsAllowlistEntity">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="name" type="xs:string"/>
            <xs:element name="uuid" type="xs:string"/>
            <xs:element name="reference-name" type="xs:string"/>
            <xs:element name="reference-uuid" type="xs:string"/>
            <xs:element name="file" type="xs:string"/>
            <xs:element name="directory" type="tlsFileLocationEntity"/>
            <xs:element name="pattern" type="tlsFileLocationEntity"/>
        </xs:choice>
    </xs:complexType>

    <!-- No format element: one call reads both the PEM and the DER encoding. -->
    <xs:complexType name="tlsRevocationlistEntity">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="name" type="xs:string"/>
            <xs:element name="uuid" type="xs:string"/>
            <xs:element name="reference-name" type="xs:string"/>
            <xs:element name="reference-uuid" type="xs:string"/>
            <xs:element name="file" type="xs:string"/>
            <xs:element name="directory" type="tlsFileLocationEntity"/>
            <xs:element name="pattern" type="tlsFileLocationEntity"/>
        </xs:choice>
    </xs:complexType>

    <!-- Declared rather than guessed from an extension: a .crt file holds PEM or DER, a .pem file
         holds a key or a certificate or both, and a file Kubernetes mounts is named after the key in
         the secret. -->
    <xs:simpleType name="tlsMaterialFormat">
        <xs:restriction base="xs:string">
            <xs:enumeration value="p12"/>
            <xs:enumeration value="jks"/>
            <xs:enumeration value="pem"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- A truststore the runtime carries rather than the operator supplies. -->
    <xs:simpleType name="tlsBuiltinTruststore">
        <xs:restriction base="xs:string">
            <xs:enumeration value="JVM-cacerts"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- TLS material End -->

    <!-- Pulse Start -->
    <xs:complexType name="pulseEntity">
        <xs:sequence>
            <xs:element name="managed-assets" type="pulseAssetsEntity"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="pulseAssetsEntity">
        <xs:sequence>
            <xs:element name="managed-asset" type="pulseAssetEntity" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="pulseAssetEntity">
        <xs:sequence>
            <xs:element name="schema" type="xs:string"/>
            <xs:element name="mapping" type="pulseAssetMappingEntity"/>
        </xs:sequence>
        <xs:attribute name="name" type="xs:string" use="required"/>
        <xs:attribute name="id" type="uuidType" use="required"/>
        <xs:attribute name="description" type="xs:string" use="optional"/>
        <xs:attribute name="topic" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:complexType name="pulseAssetMappingEntity">
        <xs:attribute name="id" type="uuidType" use="optional"/>
        <xs:attribute name="status" use="required">
            <xs:simpleType>
                <xs:restriction base="xs:string">
                    <xs:enumeration value="DRAFT"/>
                    <xs:enumeration value="MISSING"/>
                    <xs:enumeration value="REQUIRES_REMAPPING"/>
                    <xs:enumeration value="STREAMING"/>
                    <xs:enumeration value="UNMAPPED"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
    </xs:complexType>
    <!-- Pulse End -->

    <!-- Internal -->
    <xs:complexType name="internalConfigEntity">
        <xs:sequence>
            <xs:element name="option" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                    <xs:all>
                        <xs:element name="key" type="nonEmptyString"/>
                        <xs:element name="value" type="xs:string"/>
                    </xs:all>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>


    <!-- Common types -->

    <xs:complexType name="keystoreEntity">
        <xs:all>
            <xs:element name="path" type="nonEmptyString"/>
            <xs:element name="password" type="xs:string"/>
            <xs:element name="private-key-password" type="xs:string"/>
        </xs:all>
    </xs:complexType>

    <xs:complexType name="truststoreEntity">
        <xs:all>
            <xs:element name="path" type="nonEmptyString"/>
            <xs:element name="password" type="xs:string"/>
        </xs:all>
    </xs:complexType>

    <xs:simpleType name="clientAuthenticationMode">
        <xs:restriction base="xs:string">
            <xs:enumeration value="OPTIONAL"/>
            <xs:enumeration value="REQUIRED"/>
            <xs:enumeration value="NONE"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="port">
        <xs:restriction base="xs:int">
            <xs:minInclusive value="0"/>
            <xs:maxInclusive value="65535"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="nonEmptyString">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:whiteSpace value="collapse"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="uuidType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>

